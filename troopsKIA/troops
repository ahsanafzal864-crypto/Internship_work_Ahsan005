              <span>[Ref ${rNum}]</span>
              <svg class="w-2.5 h-2.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          `;
        }).join('');

        const card = document.createElement('div');
        card.className = `p-4 rounded-xl border transition-all duration-200 flex flex-col justify-between shadow-xs ${borderTone}`;
        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between text-xs mb-2">
              <span class="px-2.5 py-0.5 rounded-full font-mono text-[11px] font-semibold border ${badgeStyle}">
                ${flagLabel}
              </span>
              <span class="font-mono text-[11px] text-military-500 font-medium">${item.id}</span>
            </div>
            <div class="mt-2.5">
              <span class="text-xs uppercase font-mono tracking-wider text-military-600 font-semibold">${item.rank}</span>
              <h3 class="text-base font-bold text-military-900 tracking-tight mt-0.5">${item.name}</h3>
            </div>
            <div class="mt-2.5 flex items-center gap-2 text-xs text-military-600 font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-military-400"></span>
              <span>${item.branch}</span>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-military-150 flex items-center justify-between">
            <span class="text-[11px] font-mono text-military-500">Source:</span>
            <div class="flex flex-wrap gap-1">
              ${refChips}
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function renderTable(records) {
      const tbody = document.getElementById('tableBody');
      tbody.innerHTML = '';

      records.forEach((item, index) => {
        const isIndia = item.faction === 'india';
        const refList = isIndia ? indianReferences : pakistanReferences;
        
        const badgeColor = isIndia 
          ? 'bg-amber-100 text-amber-900 border-amber-300' 
          : 'bg-emerald-100 text-emerald-900 border-emerald-300';

        const linksHtml = item.refs.map(rNum => {
          const refObj = refList.find(r => r.id === rNum);
          return `<a href="${refObj ? refObj.url : '#'}" target="_blank" rel="noopener noreferrer" class="text-military-700 hover:text-military-900 font-semibold underline underline-offset-2 mr-2 font-mono text-xs">[Ref ${rNum}]</a>`;
        }).join('');

        const tr = document.createElement('tr');
        tr.className = 'hover:bg-military-50 transition-colors';
        tr.innerHTML = `
          <td class="py-3 px-4 font-mono text-military-500">${index + 1}</td>
          <td class="py-3 px-4">
            <span class="px-2.5 py-0.5 text-[11px] rounded border font-mono font-medium ${badgeColor}">
              ${isIndia ? 'India' : 'Pakistan'}
            </span>
          </td>
          <td class="py-3 px-4">
            <span class="font-mono text-xs text-military-600 font-medium">${item.rank}</span>
            <span class="font-bold text-military-900 ml-1.5">${item.name}</span>
          </td>
          <td class="py-3 px-4 text-military-700 font-medium">${item.branch}</td>
          <td class="py-3 px-4">${linksHtml}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function updateDisplay() {
      const filtered = getFilteredRecords();
      document.getElementById('rendered-count').innerText = filtered.length;

      const emptyBox = document.getElementById('emptyPlaceholder');
      const cardsBox = document.getElementById('cardsViewContainer');
      const tableBox = document.getElementById('tableViewContainer');

      if (filtered.length === 0) {
        cardsBox.classList.add('hidden');
        tableBox.classList.add('hidden');
        emptyBox.classList.remove('hidden');
        return;
      }

      emptyBox.classList.add('hidden');

      if (currentViewMode === 'cards') {
        cardsBox.classList.remove('hidden');
        tableBox.classList.add('hidden');
        renderCards(filtered);
      } else {
        cardsBox.classList.add('hidden');
        tableBox.classList.remove('hidden');
        renderTable(filtered);
      }
    }

    function setFactionFilter(faction) {
      currentFaction = faction;
      
      const btnAll = document.getElementById('filter-btn-all');
      const btnIn = document.getElementById('filter-btn-india');
      const btnPk = document.getElementById('filter-btn-pakistan');

      const activeClass = "bg-military-600 text-white shadow-xs font-semibold";
      const inactiveClass = "text-military-700 hover:text-military-900 font-semibold";

      btnAll.className = `px-3.5 py-1.5 text-xs rounded-md transition-all ${faction === 'all' ? activeClass : inactiveClass}`;
      btnIn.className = `px-3.5 py-1.5 text-xs rounded-md transition-all ${faction === 'india' ? activeClass : inactiveClass}`;
      btnPk.className = `px-3.5 py-1.5 text-xs rounded-md transition-all ${faction === 'pakistan' ? activeClass : inactiveClass}`;

      updateDisplay();
    }

    function handleSearch() {
      currentSearchTerm = document.getElementById('searchInput').value.trim();
      updateDisplay();
    }

    function setViewMode(mode) {
      currentViewMode = mode;
      const cardBtn = document.getElementById('view-card-btn');
      const tableBtn = document.getElementById('view-table-btn');

      if (mode === 'cards') {
        cardBtn.className = "p-1.5 rounded-md bg-white text-military-800 shadow-xs border border-camo-border/60";
        tableBtn.className = "p-1.5 rounded-md text-military-600 hover:text-military-900 transition-colors";
      } else {
        cardBtn.className = "p-1.5 rounded-md text-military-600 hover:text-military-900 transition-colors";
        tableBtn.className = "p-1.5 rounded-md bg-white text-military-800 shadow-xs border border-camo-border/60";
      }
      updateDisplay();
    }

    // Populate references at the footer section
    function populateReferences() {
      const inContainer = document.getElementById('indianReferencesList');
      const pkContainer = document.getElementById('pakistanReferencesList');

      indianReferences.forEach(ref => {
        const li = document.createElement('li');
        li.className = 'pt-2.5 pb-1 flex items-start gap-2 group';
        li.innerHTML = `
          <span class="text-amber-800 font-bold shrink-0">[${ref.id}]</span>
          <a href="${ref.url}" target="_blank" rel="noopener noreferrer" class="hover:text-military-900 hover:underline transition-colors flex items-center gap-1.5 break-all">
            <span>${ref.title}</span>
            <svg class="w-3.5 h-3.5 shrink-0 text-military-400 group-hover:text-military-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        `;
        inContainer.appendChild(li);
      });

      pakistanReferences.forEach(ref => {
        const li = document.createElement('li');
        li.className = 'pt-2.5 pb-1 flex items-start gap-2 group';
        li.innerHTML = `
          <span class="text-emerald-800 font-bold shrink-0">[${ref.id}]</span>
          <a href="${ref.url}" target="_blank" rel="noopener noreferrer" class="hover:text-military-900 hover:underline transition-colors flex items-center gap-1.5 break-all">
            <span>${ref.title}</span>
            <svg class="w-3.5 h-3.5 shrink-0 text-military-400 group-hover:text-military-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        `;
        pkContainer.appendChild(li);
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      populateReferences();
      updateDisplay();
    });
  </script>
</body>
</html>
