      return casualtyData.filter(item => {
        const matchesFaction = currentFaction === 'all' || item.faction === currentFaction;
        const query = currentSearchTerm.toLowerCase();
        const matchesSearch = 
          item.name.toLowerCase().includes(query) ||
          item.rank.toLowerCase().includes(query) ||
          item.branch.toLowerCase().includes(query) ||
          item.id.toLowerCase().includes(query);
        return matchesFaction && matchesSearch;
      });
    }

